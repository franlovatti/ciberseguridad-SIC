                    "dst_host_same_srv_rate": 1.0,
                    "dst_host_diff_srv_rate": 0.0,
                    "dst_host_serror_rate": 0.2,
                    "protocol_type": "tcp",
                    "flag": "SF",
                    "service": "http"
                },
                {
                    "id": 3,
